{
  "name": "chatbot-rag",
  "version": "1.0.0",
  "description": "A low-cost RAG chatbot solution for small businesses",
  "main": "index.js",
  "scripts": {
    "deploy": "./deploy.sh",
    "build": "webpack --mode production",
    "upload-docs": "node scripts/upload-documents.js",
    "cleanup-db": "node scripts/cleanup-database.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:verbose": "jest --verbose",
    "test:backend": "jest src/backend/",
    "test:scripts": "jest scripts/",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix"
  },
  "keywords": [
    "chatbot",
    "rag",
    "aws",
    "bedrock",
    "serverless"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-cdk/aws-apigatewayv2-alpha": "^2.90.0-alpha.0",
    "@aws-cdk/aws-apigatewayv2-integrations-alpha": "^2.90.0-alpha.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.400.0",
    "@aws-sdk/client-bedrock-runtime": "^3.400.0",
    "@aws-sdk/client-cloudformation": "^3.400.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.400.0",
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/client-secrets-manager": "^3.400.0",
    "@aws-sdk/client-textract": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.400.0",
    "aws-cdk-lib": "^2.90.0",
    "constructs": "^10.2.70",
    "node-cache": "^5.1.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@jest/globals": "^29.5.0",
    "@types/node": "^20.5.7",
    "babel-jest": "^29.5.0",
    "eslint": "^8.42.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.6.4",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "~5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
